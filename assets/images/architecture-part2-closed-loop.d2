# Part 2 — Closed-Loop Learning
# Simplifies the Part 1 real-time path into a single block and adds the two
# feedback loops: a batch retraining loop and an agentic parameter-tuning loop,
# plus governed zero-downtime deployment. SageMaker is intentionally not shown;
# the training step is represented as generic GPU retraining.

direction: down

title: |md
  # Accelerator-Optimized Agentic Bidding — Part 2: Closed-Loop Learning
| {
  near: top-center
  style.font-size: 28
  style.bold: true
}

exchange: "Ad Exchange / DSP\nOpenRTB bidstream" {
  shape: cloud
  style.fill: "#EFE9FB"
  style.stroke: "#8C4FFF"
}

aws: "AWS Cloud" {
  style.stroke: "#232F3E"
  style.font-size: 20
  style.bold: true
  grid-columns: 2

  rtb: "Real-Time Bidding (Amazon EKS)\nOrchestrator + 5 ARTF containers" {
    style.fill: "#FDEBD0"
    style.stroke: "#ED7100"
    triton: "NVIDIA Triton (GPU A10G or G7e (Blackwell))\n3 ONNX models + 2 XGBoost (FIL)" {
      style.fill: "#76b900"
      style.stroke: "#5a8c00"
      style.font-color: "#000000"
    }
  }

  params: "Parameter Store (DynamoDB)\nshade_factor · conversion_value" {
    shape: cylinder
    style.fill: "#F7D9F9"
    style.stroke: "#C925D1"
  }

  feedback: "Feedback Data Pipeline (Bid Pricer + Deal Scorer)" {
    style.stroke: "#8C4FFF"
    style.font-size: 20
    direction: right
    kds: "Kinesis Data Stream\nBid Outcomes"
    kdf: "Kinesis Data Firehose\nBuffer + partition"
    s3raw: "Amazon S3\nRaw Outcomes (Parquet)" {
      shape: cylinder
      style.fill: "#E4F2DD"
      style.stroke: "#3F8624"
    }
    glue: "AWS Glue ETL\nFeature Engineering"
    s3train: "Amazon S3\nTraining Data" {
      shape: cylinder
      style.fill: "#E4F2DD"
      style.stroke: "#3F8624"
    }
    kds -> kdf -> s3raw -> glue -> s3train
  }

  yield_feedback: "Feedback Data Pipeline (Yield Optimizer)\nSeparate stream/table — different event shape" {
    style.stroke: "#8C4FFF"
    style.font-size: 20
    direction: right
    kds: "Kinesis Data Stream\nDeal Yield Outcomes"
    kdf: "Kinesis Data Firehose\nBuffer + partition"
    s3raw: "Amazon S3\nRaw Deal Yield Outcomes (Parquet)" {
      shape: cylinder
      style.fill: "#E4F2DD"
      style.stroke: "#3F8624"
    }
    glue: "AWS Glue ETL\nFloor + Margin Labeling"
    s3train: "Amazon S3\nFloor + Margin Training Data" {
      shape: cylinder
      style.fill: "#E4F2DD"
      style.stroke: "#3F8624"
    }
    kds -> kdf -> s3raw -> glue -> s3train
  }

  bootstrap: "Yield Optimizer Bootstrap Sources\n(no live win/loss signal yet)" {
    style.stroke: "#8C4FFF"
    style.font-size: 18
    style.stroke-dash: 3
    loadtest: "Load Test traffic\nsource=load_test (disclosed, synthetic)"
    explore: "Bounded Exploration (in-container)\nepsilon-greedy, disclosed via :explore suffix"
  }

  retrain: "Batch Retraining Loop (GPU) — Bid Pricer + Deal Scorer" {
    style.stroke: "#76b900"
    direction: down
    style.font-size: 20
    nemo: "NVIDIA NeMo-RL\nRL policy optimization" {
      style.fill: "#76b900"
      style.stroke: "#5a8c00"
      style.font-color: "#000000"
    }
    registry: "Model Registry\nVersioned artifacts + lineage" {
      shape: cylinder
    }
    nemo -> registry: "register new version"
  }

  yield_retrain: "Batch Retraining Loop — Yield Optimizer" {
    style.stroke: "#76b900"
    direction: down
    style.font-size: 20
    xgb: "Amazon SageMaker\nBuilt-in XGBoost training (floor + margin)" {
      style.fill: "#76b900"
      style.stroke: "#5a8c00"
      style.font-color: "#000000"
    }
    registry: "Model Registry\nFloor + margin package groups" {
      shape: cylinder
    }
    xgb -> registry: "register new version"
  }

  agents: "Amazon Bedrock AgentCore Runtimes" {
    style.stroke: "#ED7100"
    gov: "Model Governance Agent\nA/B test + approval gate"
    bsa: "Adaptive Bidding Strategy Agent\ntunes pricing parameters"
  }

  deploy: "Zero-Downtime Deployment" {
    style.stroke: "#76b900"
    direction: down
    optimizer: "Model Optimizer (in-cluster)\nlocal TensorRT engine build — NIM-like, no external dependency" {
      style.fill: "#76b900"
      style.stroke: "#5a8c00"
      style.font-color: "#000000"
    }
    canary: "Canary Deployer\nProgressive rollout"
    optimizer -> canary: "optimized model"
  }

  events: "Amazon EventBridge\nRule + Scheduler" {
    style.fill: "#FBD7E8"
    style.stroke: "#E7157B"
  }

  cw: "Amazon CloudWatch\nMetrics" {
    style.fill: "#FBD7E8"
    style.stroke: "#E7157B"
  }
}

exchange -> aws.rtb: "OpenRTB BidRequest"
aws.rtb -> exchange: "RTBResponse (mutations)"

# Feedback collection
aws.rtb -> aws.feedback.kds: "bid outcomes (win/loss, price, CTR)"
aws.rtb -> aws.yield_feedback.kds: "deal yield outcomes (floor/margin)"

# Batch retraining
aws.feedback.s3train -> aws.retrain.nemo: "labeled training data"
aws.retrain.registry -> aws.events: "new version registered"

aws.yield_feedback.s3train -> aws.yield_retrain.xgb: "labeled floor + margin data"
aws.yield_retrain.registry -> aws.events: "new version registered"

# Bootstrap sources feed the yield feedback pipeline until a live
# win/loss signal path exists
aws.bootstrap.loadtest -> aws.yield_feedback.kds: "synthetic outcome"
aws.bootstrap.explore -> aws.rtb.triton: "perturbed prediction"

# Governance + deployment
aws.events -> aws.agents.gov: "invoke (rule)"
aws.agents.gov -> aws.deploy.optimizer: "approved"
aws.deploy.canary -> aws.rtb.triton: "canary → promote"

# Agentic parameter-tuning loop
aws.rtb -> aws.cw: "metrics"
aws.events -> aws.agents.bsa: "invoke (every 5 min)"
aws.cw -> aws.agents.bsa: "win rate, cost, revenue"
aws.agents.bsa -> aws.params: "update params"
aws.params -> aws.rtb: "read at inference" {
  style.stroke-dash: 4
}

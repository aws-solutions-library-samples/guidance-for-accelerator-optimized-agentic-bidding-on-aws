.coverage
htmlcov/
coverage/

# --- Local environment ---
.env.development
.env.production
.env.local

# --- Triton model artifacts ---
# Regenerated by source/triton/export_models.py during deploy.sh (Step 2).
# Not source; do not commit.
source/triton/model_repository/**/*.onnx
# ONNX staging dir: rm -rf'd and regenerated every deploy (deploy.sh Step 2),
# uploaded to S3 as the Model Optimizer's source. Pure build output.
source/triton/onnx_export/

# --- Amazon Ember (proprietary) brand fonts ---
# Fetched at deploy time from an authorized source (AMAZON_EMBER_FONT_BASE_URL);
# proprietary, must NOT be committed to this public repo. See
# source/frontend-react/public/fonts/README.md.
source/frontend-react/public/fonts/*.woff2

# --- Deployment-state files ---
.cognito-outputs.json
.frontend-outputs.json
.frontend-vanilla-outputs.json
.image-outputs.json
.nemo-outputs.json
deployment/.bootstrap-status.json
# Per-prefix record of the flags a run was GIVEN, and the values it resolved, so a
# re-run need not be told them again. Deliberately holds no progress -- that comes
# from AWS via `./deploy.sh --status`. Local state, not source.
deployment/.deploy-state.json
# Captured output from the noisy deploy steps (AgentCore runtimes, agent image
# builds, the closed-loop stack), so a failure there is readable after the fact
# instead of living only in a terminal's scrollback. One glob covers the lot,
# including the per-prefix variants (.deploy-bt1-closed-loop.log).
deployment/.deploy-*.log

# --- Kiro ---
.kiro/
source/triton/onnx_export
gtm
aidlc-docs
deployment/guidance-for-accelerator-optimized-agentic-bidding-on-aws.code-workspace
Triton Publisher Yield Models.md
ARTF — SSP_Publisher Intents.md
deployment/output.txt

# Written by deploy_prebid.sh step 8: a record of ONE deployment (cluster, ECR repo,
# image digest, endpoints, account-specific names). Local state, not source -- committing
# it would put one operator's account details in every other operator's checkout.
.prebid-deployment.json

# Editor workspace files and the retired composability docs (kept locally as a backup).
*.code-workspace
composability-documentation
_bk_composability-documentation


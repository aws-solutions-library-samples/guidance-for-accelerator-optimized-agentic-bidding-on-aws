# Model Optimizer Service (the design's model-optimization role, TensorRT-based)
# =============================================================================
#
# Compiles newly-trained ONNX recommender models (DLRM, NCF, Wide&Deep) into
# optimized TensorRT engine plans that Triton loads as new canary versions.
# Runs OUT-OF-BAND during model promotion — it is NOT in the ARTF real-time
# serving path (the ARTF containers only ever call in-cluster Triton).
#
# This is a real NVIDIA TensorRT toolchain (trtexec), NOT a stock NVIDIA NIM
# container — no stock NIM exists for these custom recommender models. TensorRT
# is the same engine NIM is built on.
#
# Base image: NVIDIA TensorRT 24.08 — pinned to match the Triton serving image
# (nvcr.io/nvidia/tritonserver:24.08-py3) so engines built here are loadable by
# Triton's tensorrt_plan backend. Pulling this image requires an NGC login
# (handled by the CodeBuild buildspec using the NGC API key secret).
#
# amd64 only: engines are GPU-architecture-specific and must be built on the
# same NVIDIA A10G (g5.xlarge, x86_64) the ARTF Triton server runs on.

FROM nvcr.io/nvidia/tensorrt:24.08-py3

WORKDIR /app

# trtexec ships in the TensorRT container but is not on PATH by default.
ENV TRTEXEC_PATH=/usr/src/tensorrt/bin/trtexec

COPY optimizer/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY optimizer/ /app/optimizer/

# HTTP service on 8080 (POST /v1/optimize, GET /health)
EXPOSE 8080

ENTRYPOINT ["python", "-m", "optimizer.app"]

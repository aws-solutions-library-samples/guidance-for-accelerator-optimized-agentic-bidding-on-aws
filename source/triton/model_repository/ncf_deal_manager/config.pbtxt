# NCF Deal Manager — CANARY ROUTER (Triton Python backend).
# The model the ARTF NCF container calls by name ("ncf_deal_manager") — unchanged
# client signature. Forwards to ncf_deal_manager_stable / ncf_deal_manager_canary
# by an in-memory canary_traffic_pct (control-plane; no per-request external I/O).
# Model source: source/triton/router/model.py.

name: "ncf_deal_manager"
backend: "python"
max_batch_size: 128

input [
  {
    name: "user_ids"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "item_ids"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "target_variant"
    data_type: TYPE_STRING
    dims: [ 1 ]
    optional: true
  }
]

output [
  {
    name: "relevance_scores"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "served_variant"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "served_model_version"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

parameters [
  { key: "stable_model", value: { string_value: "ncf_deal_manager_stable" } },
  { key: "canary_model", value: { string_value: "ncf_deal_manager_canary" } },
  { key: "canary_traffic_pct", value: { string_value: "0" } },
  { key: "stable_version_arn", value: { string_value: "" } },
  { key: "canary_version_arn", value: { string_value: "" } }
]

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

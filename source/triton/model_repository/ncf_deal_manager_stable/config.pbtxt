# NCF Deal Manager — STABLE engine (TensorRT).
# Served behind the ncf_deal_manager router. model.plan built by the Model
# Optimizer at deploy + on promotion. Batch profile 1..128.

name: "ncf_deal_manager_stable"
platform: "tensorrt_plan"
max_batch_size: 128

input [
  {
    name: "user_ids"
    data_type: TYPE_INT64
    dims: [ 1 ]
    reshape: { shape: [] }
  },
  {
    name: "item_ids"
    data_type: TYPE_INT64
    dims: [ 1 ]
    reshape: { shape: [] }
  }
]

output [
  {
    name: "relevance_scores"
    data_type: TYPE_FP32
    dims: [ 1 ]
    reshape: { shape: [] }
  }
]

dynamic_batching {
  preferred_batch_size: [ 16, 32, 64 ]
  max_queue_delay_microseconds: 500
}

instance_group [
  {
    count: 2
    kind: KIND_GPU
  }
]
# Warm-up: Triton runs these requests on each instance at load and reports the
# model not ready until they complete (Triton r24.08 model_configuration.md,
# "Model Warmup"; ModelWarmup in common/protobuf/model_config.proto). dims are
# the declared input dims (before reshape), without the batch dimension. Batch 1
# and 16, the opt batch of this engine's profile in deployment/optimizer-bootstrap.json.
model_warmup [
  {
    name: "zero_batch1"
    batch_size: 1
    inputs {
      key: "user_ids"
      value: {
        data_type: TYPE_INT64
        dims: [ 1 ]
        zero_data: true
      }
    }
    inputs {
      key: "item_ids"
      value: {
        data_type: TYPE_INT64
        dims: [ 1 ]
        zero_data: true
      }
    }
  },
  {
    name: "zero_batch16"
    batch_size: 16
    inputs {
      key: "user_ids"
      value: {
        data_type: TYPE_INT64
        dims: [ 1 ]
        zero_data: true
      }
    }
    inputs {
      key: "item_ids"
      value: {
        data_type: TYPE_INT64
        dims: [ 1 ]
        zero_data: true
      }
    }
  }
]

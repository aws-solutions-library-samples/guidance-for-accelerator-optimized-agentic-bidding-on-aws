# DLRM Bid Shader — CANARY ROUTER (Triton Python backend).
# =============================================================================
# This is the model the ARTF DLRM container calls by name ("dlrm_bid_shader") —
# UNCHANGED client-facing signature. It forwards each request to either
# dlrm_bid_shader_stable or dlrm_bid_shader_canary (TensorRT engines) based on an
# in-memory canary_traffic_pct read at load/reload (control-plane), so the
# bidstream path has NO external dependency (ARTF-compliant). Model source:
# source/triton/router/model.py.
#
# No dynamic_batching here (per-request routing); GPU batching happens in the
# stable/canary TensorRT models, which keep their own dynamic_batching.

name: "dlrm_bid_shader"
backend: "python"
max_batch_size: 64

input [
  {
    name: "dense_features"
    data_type: TYPE_FP32
    dims: [ 4 ]
  },
  {
    name: "sparse_user"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "sparse_domain"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "sparse_device"
    data_type: TYPE_INT64
    dims: [ 1 ]
  }
]

output [
  {
    name: "ctr_prediction"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

parameters [
  { key: "stable_model", value: { string_value: "dlrm_bid_shader_stable" } },
  { key: "canary_model", value: { string_value: "dlrm_bid_shader_canary" } },
  { key: "canary_traffic_pct", value: { string_value: "0" } }
]

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]
